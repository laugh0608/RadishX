# Repository text files default to UTF-8, LF, and a final newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml,css,scss,html}]
indent_size = 2

[*.{gitignore,dockerignore,gitattributes,editorconfig}]
indent_size = 2

[*.sh]
end_of_line = lf
indent_size = 2

[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf
indent_size = 4
